# ---- HTTP ----
PORT=3000
# Comma separated list or "*"
CORS_ORIGINS=*
LOG_LEVEL=log

# ---- Auth ----
# Used to sign device access tokens. If omitted a random secret is generated at boot
# (tokens become invalid after a restart; desktop clients re-register transparently).
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=86400

# ---- Storage ----
DATA_DIR=/app/data

# ---- Connections ----
CONNECTION_REQUEST_TIMEOUT_SECONDS=60

# ---- Cloudflare Realtime SFU ----
CF_REALTIME_API_BASE=https://rtc.live.cloudflare.com/v1
CF_REALTIME_APP_ID=
CF_REALTIME_APP_SECRET=

# ---- Cloudflare Realtime TURN ----
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=
CF_TURN_CREDENTIAL_TTL_SECONDS=86400
